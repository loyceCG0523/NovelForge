# 应用运行环境，本地开发保持 local 即可。
APP_ENV=local

# PostgreSQL + pgvector：业务数据与后续向量检索共用的本地数据库。
POSTGRES_DB=novelforge
POSTGRES_USER=novelforge
POSTGRES_PASSWORD=novelforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://novelforge:novelforge@localhost:5432/novelforge

# Redis：Agent 异步任务队列。
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
AGENT_TASK_QUEUE=novelforge:agent_tasks
MEMORY_TASK_QUEUE=novelforge:memory_tasks
TASK_LEASE_SECONDS=270
TASK_HEARTBEAT_SECONDS=15
TASK_RECOVERY_INTERVAL_SECONDS=30
# Embedding 的 Endpoint、API Key、模型和开关在前端“设置”页面按用户保存。
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20

# MinIO：本地 S3 兼容对象存储，后续放导出文件和素材。
MINIO_ROOT_USER=novelforge
MINIO_ROOT_PASSWORD=novelforge123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=novelforge-local
S3_ACCESS_KEY_ID=novelforge
S3_SECRET_ACCESS_KEY=novelforge123

# Auth：JWT_SECRET 本地可以先用占位值，云端部署必须替换为强随机值。
JWT_SECRET=replace_with_a_long_random_secret_for_local_dev

# LLM 网关：后续接 OpenAI-compatible API 时填写。
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
